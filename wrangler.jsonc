{
  "name": "cratefolk",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],

  // Builds the web app before every deploy, so Cloudflare's default build and deploy commands work as they are.
  "build": { "command": "npm run build -w @cratefolk/web" },

  // The built web app. Only /api/* reaches the Worker; everything else is a static file, or index.html for the app's own routes.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // No ids on purpose: the first `wrangler deploy` (or the GitHub build) creates these and binds them. The Worker creates its own tables.
  "d1_databases": [{ "binding": "DB", "database_name": "cratefolk" }],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "cratefolk-covers" }],
  // Optional: thumbnails. Without it, grids load the full-size covers.
  "images": { "binding": "IMAGES" },
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "cratefolk-sync" }],
    "consumers": [{ "queue": "cratefolk-sync", "max_batch_size": 1, "max_retries": 0 }]
  },
  // Clears expired sessions and old activity.
  "triggers": { "crons": ["0 */6 * * *"] },

  "vars": {
    "COOKIE_SECURE": "true"
  }
  // Secrets: `npx wrangler secret put <NAME>`
  //   ADMIN_EMAIL      admin account (can also be a plain var)
  //   ADMIN_PASSWORD   admin password
  //   DISCOGS_TOKEN    optional, a server-wide Discogs token
  //   SECRET_KEY_RAW   when moving an existing instance: the contents of its data/secret.key, so stored Discogs tokens stay readable
}
