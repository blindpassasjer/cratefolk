{
  "name": "@cratefolk/worker",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Cloudflare Workers deployment of Cratefolk. Not an npm workspace on purpose: the Docker build never installs wrangler.",
  "scripts": {
    "dev": "wrangler dev -c ../../wrangler.jsonc",
    "deploy": "wrangler deploy -c ../../wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
