{
  "name": "@cratefolk/worker",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Cloudflare Workers deployment of Cratefolk. Not an npm workspace on purpose: the Docker build never installs wrangler.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "npm run build -w @cratefolk/web --prefix ../.."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
