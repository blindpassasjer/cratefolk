# Required: the admin account is created (and its password kept in sync) on every start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Discogs personal access token (https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Optional
PORT=3000
DATA_DIR=./data
# Set to true when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false
